# addresses.py.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to addresses.py (in the project root) and replace the
# placeholder values with the real addresses for YOUR instrument setup.
#
# HOW TO FIND COM PORTS (Windows):
#   1. Open Device Manager  (Win + X → Device Manager)
#   2. Expand "Ports (COM & LPT)"
#   3. Look for:
#        "USB Serial Port (COMx)"  ← your Eurotherm or pressure gauge
#   4. Write down the COMx number and enter it below.
#
# HOW TO FIND NI DEVICE NAME:
#   1. Open "NI MAX" (NI Measurement & Automation Explorer)
#   2. Expand "My System" → "Devices and Interfaces"
#   3. Note the device name (e.g. "Dev1", "Dev2")
#
# NOTE: Never commit addresses.py to Git — it is listed in .gitignore.
#       Only this .example file (with placeholder values) is version-controlled.
# ─────────────────────────────────────────────────────────────────────────────

# ── Simulation mode ───────────────────────────────────────────────────────────
# False on the instrument PC (real Eurotherm + pressure gauge).
# True on a development laptop (simulated data, no serial ports needed).
# If this line is missing, GUIv5.py falls back to True.
SIMULATION = False

# ── Optional per-loop script options (Eurotherm loops only, default False) ───
#   "script_direct_setpoint": True
#       temperature_ramp() in scripts just writes the setpoint, like the GUI
#       "Set" button — no ramp generator / OP changes.
#       (mbe1: Se1, Se2 — mbe2: Te-Cracker, Te-Tube)
#   "script_keep_ramp_generator": True
#       temperature_ramp() skips the "ramp generator OFF" safety interlock and
#       restores the ramp generator to its previous state afterwards.
#       (mbe2: Te-Res)

addresses = {
    # ── Au (Gold) Eurotherm temperature controller ───────────────────────────
    # Serial port: COM1  (shared RS-485 Modbus bus), Modbus slave address: 1
    "Au": {
        "device": ("COM1", 1),          # ("COMx", <modbus_slave_id>)  ← CHANGE COM PORT
        "temperature_pv":       (1,  1),
        "temperature_setpoint": (2,  1),
        "output_setpoint":      (3,  1),
        "output_pv":            (4,  1),
        "status":               (273, 0),
        "Ramp_temp":            (35,  1),
        "ramp_op_status":       (87,  0),
        "Ramp_OP":              (37,  2),
        "critical_zone": {
            "range":     (1014, 1114),  # Au melting point ~1064 °C
            "slow_rate": 3.0            # °C/min through the critical zone
        },
        "thresholds": {
            "temp_warning":   300,      # °C
            "temp_critical":  400,      # °C
            "power_warning":   60,      # %
            "power_critical":  80,      # %
        },
        "shutter_line": "Dev1/port0/line2"  # NI-DAQmx digital output line  ← CHANGE
    },

    # ── CaF2 Eurotherm temperature controller ────────────────────────────────
    "CaF2": {
        "device": ("COM1", 1),          # ← CHANGE COM PORT and slave id if needed
        "temperature_pv":       (1025, 1),
        "temperature_setpoint": (1026, 1),
        "output_setpoint":      (1027, 1),
        "output_pv":            (1028, 1),
        "status":               (1297, 0),
        "Ramp_temp":            (1059, 1),
        "ramp_op_status":       (1111, 0),
        "Ramp_OP":              (1061, 2),
        "thresholds": {
            "temp_warning":   300,
            "temp_critical":  400,
            "power_warning":   60,
            "power_critical":  80,
        },
        "shutter_line": "Dev1/port0/line1"  # ← CHANGE
    },

    # ── Se1 (Selenium source 1) ───────────────────────────────────────────────
    "Se1": {
        "device": ("COM1", 7),          # Modbus slave 7  ← CHANGE if different
        "temperature_pv":       (1, 1),
        "temperature_setpoint": (2, 1),
        "output_setpoint":      (3, 1),
        "output_pv":            (4, 1),
        "status":               (273, 0),
        "Ramp_temp":            (35,  1),
        "ramp_op_status":       (87,  0),
        "Ramp_OP":              (37,  2),
        "thresholds": {
            "temp_warning":   300,
            "temp_critical":  400,
            "power_warning":   60,
            "power_critical":  80,
        },
        "shutter_line": "Dev1/port0/line3"  # ← CHANGE
    },

    # ── Se2 (Selenium source 2) ───────────────────────────────────────────────
    "Se2": {
        "device": ("COM1", 5),          # Modbus slave 5  ← CHANGE if different
        "temperature_pv":       (1, 1),
        "temperature_setpoint": (2, 1),
        "output_setpoint":      (3, 1),
        "output_pv":            (4, 1),
        "status":               (273, 0),
        "Ramp_temp":            (35,  1),
        "ramp_op_status":       (87,  0),
        "Ramp_OP":              (37,  2),
        "thresholds": {
            "temp_warning":   300,
            "temp_critical":  400,
            "power_warning":   60,
            "power_critical":  80,
        },
        "shutter_line": "Dev1/port0/line6"  # ← CHANGE
    },

    # ── Substrate heater ─────────────────────────────────────────────────────
    "Substrate": {
        "device": ("COM1", 3),          # Modbus slave 3  ← CHANGE if different
        "temperature_pv":       (1, 1),
        "temperature_setpoint": (2, 1),
        "output_setpoint":      (3, 1),
        "output_pv":            (4, 1),
        "status":               (273, 0),
        "Ramp_temp":            (35,  1),
        "ramp_op_status":       (87,  0),
        "Ramp_OP":              (37,  2),
        "thresholds": {
            "temp_warning":   300,
            "temp_critical":  400,
            "power_warning":   60,
            "power_critical":  80,
        },
    },

    # ── SnSe (Tin Selenide) ───────────────────────────────────────────────────
    "SnSe": {
        "device": ("COM1", 2),          # Modbus slave 2  ← CHANGE if different
        "temperature_pv":       (1, 1),
        "temperature_setpoint": (2, 1),
        "output_setpoint":      (3, 1),
        "output_pv":            (4, 1),
        "status":               (273, 0),
        "Ramp_temp":            (35,  1),
        "ramp_op_status":       (87,  0),
        "Ramp_OP":              (37,  2),
        "thresholds": {
            "temp_warning":   300,
            "temp_critical":  400,
            "power_warning":   60,
            "power_critical":  80,
        },
        "shutter_line": "Dev1/port0/line4"  # ← CHANGE
    },

    # ── Pressure gauge (serial ASCII, Bayard-Alpert style) ───────────────────
    "Pressure": {
        "device":   ("COM10", 300),     # ("COMx", baud_rate)  ← CHANGE COM PORT
        "command":  "DS IG1 \r\n",      # ASCII command sent to gauge (optional, default IG1)
        "unit":     "Torr",
    },

    # ── Additional shutter lines (NI-DAQmx digital output) ───────────────────
    "Liquid_N2": {
        "shutter_line": "Dev1/port0/line7"   # ← CHANGE
    },
    "eGun1": {
        "shutter_line": "Dev1/port1/line0"   # ← CHANGE
    },
    "eGun2": {
        "shutter_line": "Dev1/port1/line1"   # ← CHANGE
    },
}
